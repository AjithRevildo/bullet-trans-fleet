# Root environment file template
NODE_ENV=development

# API
PORT=5000
API_BASE_URL=http://localhost:5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/bullet_trans_fleet

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=replace_with_secure_secret
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret

# Maps
MAP_PROVIDER=mock
MAP_API_KEY=

# GPS
GPS_MODE=mock
GPS_API_KEY=

# Mail / notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Frontend
VITE_API_URL=http://localhost:5000/api/v1
VITE_APP_NAME="Bullet Trans Fleet Command Center"
